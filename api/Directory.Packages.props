<Project>

  <!-- Central Package Management: every version is declared once here, and
       csproj files reference packages without a version. This is what stops
       two projects quietly resolving different versions of EF Core. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Persistence -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
  </ItemGroup>

  <!-- Auth. Identity.Core is taken for IPasswordHasher only - see ADR-10. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
  </ItemGroup>

  <!-- Validation and mapping. Mapperly is source-generated and MIT;
       AutoMapper 15+ and MediatR 13+ are excluded on licence grounds (ADR-04, ADR-09). -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation" Version="12.1.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <!-- Application registers its own services and reads its own options, so it needs the
       abstractions for both. Neither pulls in a hosting or provider dependency. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>

  <!-- SMTP. System.Net.Mail.SmtpClient is discouraged for new code; MailKit is what
       Microsoft's own docs point at. -->
  <ItemGroup>
    <PackageVersion Include="MailKit" Version="4.16.0" />
  </ItemGroup>

  <!-- Image decoding, resizing and re-encoding.

       Licence, stated plainly because we have been bitten three times already: ImageSharp uses
       the Six Labors Split License. It is Apache 2.0 for a for-profit business under 1M USD
       annual revenue, and needs a paid commercial licence above that. Unlike AutoMapper, MediatR
       and FluentAssertions - which cost money at any commercial scale - this one is free at our
       size, and its trigger is a revenue figure worth celebrating.

       Pinned to 3.x deliberately. Version 4 added a build-time licence-key check that warns on
       every single build unless a key is supplied, even under the free tier. 3.1.x carries the
       same licence terms with no key demanded, so it stays here until either that changes or
       the revenue threshold is crossed. SkiaSharp is the MIT alternative if neither holds; it
       needs native assets, which is why it is not the default. -->
  <ItemGroup>
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Logging and API documentation -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.19" />
    <!-- Emits the OpenAPI document during build, so generating the TypeScript client needs
         neither a running API nor a database. That is what lets CI check the committed client
         is current without standing the whole stack up. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" />
  </ItemGroup>

  <!-- Testing. Shouldly rather than FluentAssertions: v8+ of the latter
       requires a paid licence for commercial use. Shouldly is free. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Connects to the hub the same way a browser does, so the group rules are tested
         through a real client rather than by calling the hub class directly. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.13.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />
  </ItemGroup>

  <!-- Transitive pin. Testcontainers 4.13.0 depends on SSH.NET 2025.1.0, which
       carries a high-severity advisory (GHSA-q939-rpr3-3284). We do not use the
       remote-Docker-over-SSH path this affects, but a known-vulnerable package in
       the tree fails the build and would fail any CI security scan. Pinning forward
       is enabled by CentralPackageTransitivePinningEnabled above. Remove this once
       Testcontainers ships a version that depends on a patched SSH.NET. -->
  <ItemGroup>
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
