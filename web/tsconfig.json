/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    // Point at library sources rather than at dist. The default mapping requires every
    // library to be built before any app will compile, which means a change in a library is
    // invisible until you remember to rebuild it. Mapping to source removes that ordering
    // entirely; `ng build <lib>` is still what produces a publishable package.
    "paths": {
      "api-client": ["./projects/shared/api-client/src/public-api.ts"],
      "auth": ["./projects/shared/auth/src/public-api.ts"],
      "realtime": ["./projects/shared/realtime/src/public-api.ts"],
      "ui": ["./projects/shared/ui/src/public-api.ts"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/dashboard/tsconfig.app.json"
    },
    {
      "path": "./projects/dashboard/tsconfig.spec.json"
    },
    {
      "path": "./projects/storefront/tsconfig.app.json"
    },
    {
      "path": "./projects/storefront/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/api-client/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/api-client/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/auth/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/auth/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/realtime/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/realtime/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/ui/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/ui/tsconfig.spec.json"
    }
  ]
}
