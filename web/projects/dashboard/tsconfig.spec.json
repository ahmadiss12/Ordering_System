/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals",
      // Vite's own types, for import.meta.glob and `?raw` imports. The icon spec reads
      // the templates and the bundled font's codepoints as text, which is a build-time
      // feature of the bundler rather than anything the browser does.
      "vite/client"
    ]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
